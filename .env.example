# Copy to .env and fill in. Never commit .env.
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DSBOT_DISCORD_TOKEN=

# SQLite for phase 1. Postgres later, e.g. postgresql+asyncpg://user:pass@host/db
DSBOT_DATABASE_URL=sqlite+aiosqlite:///./var/dsbot.db

# SQL echo (very noisy). Keep false.
DSBOT_SQL_ECHO=false

# Log level: DEBUG | INFO | WARNING | ERROR
DSBOT_LOG_LEVEL=INFO

# Log format: console (human) | json (machine)
DSBOT_LOG_FORMAT=console

# Timezone used to evaluate week boundaries when a job does not override it.
DSBOT_DEFAULT_TIMEZONE=Europe/Moscow

# Locale for bot-authored messages. en | ru
DSBOT_DEFAULT_LOCALE=ru

# How long a report may wait for follow-up photos before being warned (seconds).
# Operator-level setting: lives here, not in the database, so admins cannot change it.
DSBOT_REPORT_GROUP_WINDOW_SECONDS=120

# Server Members privileged intent. Leave false until rank resolution lands; turning it
# on also requires enabling it in the Discord developer portal.
DSBOT_ENABLE_MEMBERS_INTENT=false

# Discord user id to ping in warnings, so reporters can ask a human about a dispute.
DSBOT_CONTACT_USER_ID=263344369451401227

# Channels to serve, as guild_id:channel_id pairs separated by commas.
# Without this the bot starts with zero bindings and silently ignores every message.
DSBOT_AUTO_BIND_CHANNELS=

# Form applied to auto-bound channels.
DSBOT_AUTO_BIND_FORM=forms/training.yaml

# Instance name. Two deployments on one machine (live + test) need different names,
# different DATABASE_URL values and different tokens.
DSBOT_INSTANCE_NAME=dsbot
