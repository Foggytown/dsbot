# Copy to .env and fill in. Never commit .env.
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DSBOT_DISCORD_TOKEN=

# SQLite for phase 1. Postgres later, e.g. postgresql+asyncpg://user:pass@host/db
DSBOT_DATABASE_URL=sqlite+aiosqlite:///./var/dsbot.db

# SQL echo (very noisy). Keep false.
DSBOT_SQL_ECHO=false

# Log level: DEBUG | INFO | WARNING | ERROR
DSBOT_LOG_LEVEL=INFO

# Log format: console (human) | json (machine)
DSBOT_LOG_FORMAT=console

# Timezone used to evaluate week boundaries when a job does not override it.
DSBOT_DEFAULT_TIMEZONE=Europe/Moscow

# Locale for bot-authored messages. en | ru
DSBOT_DEFAULT_LOCALE=ru

# Server Members privileged intent. Leave false until rank resolution lands; turning it
# on also requires enabling it in the Discord developer portal.
DSBOT_ENABLE_MEMBERS_INTENT=false
