# =============================================================================
# dsbot environment
#
# ONLY THE TOKEN IS REQUIRED. Everything else has a sane default and is listed at the
# bottom, commented out, in case you need to override it.
#
# WHY THIS FILE IS SO SHORT: a stale copy of .env was uploaded to the hosting panel and
# still carried `DSBOT_DATABASE_URL=./var/...` from an old version. That silently moved the
# database out of the panel's persistent volume, where a redeploy deletes it - taking every
# report and verdict with it. A relative database path is now IGNORED: the bot uses the
# default inside the data directory and says so at startup, rather than refusing to start
# and leaving the bot down until somebody edits the panel's web form. The real lesson is
# still: keep this file minimal, and re-copy it rather than editing an old one by hand.
#
# Copy to `.env` and fill in the token. Never commit `.env`.
# =============================================================================

DSBOT_DISCORD_TOKEN=

# =============================================================================
# OPTIONAL - leave commented out unless you actually need to change them.
# =============================================================================

# Where persistent state lives. Empty means auto-detect: an existing /data or /app/data,
# else ./var. On a panel this is found for you.
# DSBOT_DATA_DIR=

# DO NOT SET THIS ON A PANEL. An explicit path that is not inside the data directory is
# deleted by the next upload. A relative path is ignored (the default is used instead); an
# absolute path outside the data directory logs a warning.
# DSBOT_DATABASE_URL=

# DSBOT_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# DSBOT_LOG_FORMAT=console        # console | json
# DSBOT_DEFAULT_TIMEZONE=Europe/Moscow
# DSBOT_DEFAULT_LOCALE=ru

# Pinged in report warnings so reporters can ask a human.
# DSBOT_CONTACT_USER_ID=

# Pinged at the bottom of every generated report. Id only: never a name or a link, since
# a report is visible to a whole server.
# DSBOT_DEVELOPER_USER_ID=

# Required for counting: without this intent Discord does not list guild members, so
# people with no reports are missing from the table instead of showing 0. Must also be
# enabled in the developer portal. Defaults to true.
# DSBOT_ENABLE_MEMBERS_INTENT=true

# Reporting tuning. Change only if you see rate limits or want a different grouping window.
# DSBOT_REACTION_READ_INTERVAL=0.05
# DSBOT_REACTION_CACHE=true
# DSBOT_REPORT_GROUP_WINDOW_SECONDS=120

# Two deployments on one machine (live + test) need different names, databases and tokens.
# DSBOT_INSTANCE_NAME=dsbot
