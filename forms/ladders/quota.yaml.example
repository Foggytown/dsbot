# =============================================================================
# QUOTA LADDER: who owes reports, and how many per week
#
# This file answers ONE question: "how many reports must this person file per week?"
# It grants NO rights. A quota tier has exactly one field that carries data:
# `required_per_week`. There is no `capabilities` field here by design, and
# `ladder-check` rejects the file if one appears — who owes a report must never be
# able to approve one.
#
# Copy to forms/ladders/quota.yaml, fill in role ids and numbers, then apply:
#
#   uv run dsbot ladder-check --file forms/ladders/quota.yaml
#   uv run dsbot ladder-apply --file forms/ladders/quota.yaml
#   uv run dsbot roster-refresh --channel <id>
#   uv run dsbot count --channel <id>
#
# -----------------------------------------------------------------------------
# `required_per_week`: reports filed per week. 0 means "owes nothing".
# -----------------------------------------------------------------------------
#
# Someone holding SEVERAL roles from this file gets the HIGHEST tier's number, not the
# sum. A Senior Instructor who still has their old Instructor role is asked for 4, not
# 4+3:
#
#   roles: [senior_role, instructor_role]  ->  4     (not 7)
#
# A promotion must not silently double someone's duty.
#
# -----------------------------------------------------------------------------
# PER-CHANNEL OVERRIDE (rare)
# -----------------------------------------------------------------------------
#
# If one channel genuinely needs a different number, override just that channel without
# touching this file:
#
#   uv run dsbot quota-set --channel <id> --tier instructor --count 5
#
# The override applies to that channel only; elsewhere this file's number stands.
# =============================================================================

key: quota
purpose: quota
name: Специализации — отчётность
guild_id: 1274460259661910149

tiers:
  # `ordinal` only decides which number wins when someone holds several roles.
  - key: head_instructor
    label: Head Instructor
    ordinal: 50
    roles: []
    required_per_week: 2

  - key: senior_instructor
    label: Senior Instructor
    ordinal: 30
    roles: []
    required_per_week: 4

  - key: instructor
    label: Instructor
    ordinal: 10
    roles: []
    required_per_week: 3
