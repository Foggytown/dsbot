# =============================================================================
# REVIEW LADDER: who may approve or reject a report
#
# This file answers ONE question: "whose verdict counts, and who outranks whom?"
# It says nothing about how many reports anyone must file - that is quota.yaml.
#
# Copy to forms/ladders/review.yaml, fill in role ids, then:
#
#   uv run dsbot ladder-check --file forms/ladders/review.yaml
#   uv run dsbot ladder-apply --file forms/ladders/review.yaml
#
# -----------------------------------------------------------------------------
# `ordinal` = whose verdict is stronger. Higher wins.
# -----------------------------------------------------------------------------
#
#   ✅ senior instructor approves a report        -> approved
#   ❌ head instructor rejects the same report    -> rejected   (higher ordinal wins)
#   ✅ one senior approves, ❌ another senior rejects -> conflict (never guessed)
#
# Two people in the SAME tier who disagree produce `conflict`, and the report is left
# for a human instead of picking a side.
#
# `capabilities` decides what a tier may do. Ordinal never grants anything:
#
#   review        may approve or reject a report
#   admin         may change configuration from Discord
#   quota_manage  may change weekly requirements
#
# A reviewer MAY approve their own report: that is normal here, not an error.
# Everyone who approves is NOT automatically required to file reports; that is a
# separate file, so a tier here can be absent from quota.yaml.
# =============================================================================

key: review
purpose: review
name: Специализации — проверяющие
guild_id: 1274460259661910149

tiers:
  - key: high_command
    label: High Command
    ordinal: 100
    roles: []
    capabilities: [review]

  - key: head_instructor
    label: Head Instructor
    ordinal: 50
    roles: []
    capabilities: [review, admin, quota_manage]

  - key: senior_instructor
    label: Senior Instructor
    ordinal: 30
    roles: []
    capabilities: [review]
