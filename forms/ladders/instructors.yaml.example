# =============================================================================
# Rank ladder for one guild
#
# A ladder is the authority ordering for tiers in ONE Discord server. Roles live in
# the specialization servers, so this file is bound to a specific guild id.
#
# Check:  uv run dsbot ladder-check --file forms/ladders/instructors.yaml
# Apply:  uv run dsbot ladder-apply --file forms/ladders/instructors.yaml
#
# ordinal answers exactly one question: whose verdict outranks whose.
# It does NOT grant permissions - use capabilities for that.
#
# capabilities (optional):
#   review        may approve or reject a report
#   admin         may configure forms, ladders and quotas
#   quota_manage  may change weekly requirements
#
# WHO IS COUNTED comes from `roles` too: everyone holding a role listed here is in the
# weekly table, including people who filed nothing (they show as 0). A tier with an
# empty `roles` list therefore contributes nobody and cannot approve anything, and
# `ladder-check` reports it as a problem.
#
# Where to get a role id: Discord > Server Settings > Roles > right-click the role >
# Copy Role ID (requires Developer Mode in Advanced settings).
# =============================================================================

key: instructors
name: Специализации — инструкторы
guild_id: 1274460259661910149

tiers:
  # Highest first is only a convention; ordering comes from `ordinal`.
  - key: high_command
    label: High Command
    ordinal: 100
    roles: []
    capabilities: [review]

  - key: head_instructor
    label: Head Instructor
    ordinal: 50
    roles: []
    capabilities: [review, admin, quota_manage]

  - key: senior_instructor
    label: Senior Instructor
    ordinal: 30
    roles: []
    capabilities: [review]

  # Senior instructor and above may approve; this tier may not (`capabilities` empty).
  # Its members still appear in the count, because they are the people who owe reports.
  - key: instructor
    label: Instructor
    ordinal: 10
    roles: []
    capabilities: []
