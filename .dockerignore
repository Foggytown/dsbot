# Keep the build context small and free of secrets.
# .env is deliberately excluded: the token must never be baked into an image.
.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
coverage.xml
var
*.db
*.db-wal
*.db-shm
backfill-out
.idea
.vscode
Thumbs.db
desktop.ini
*.md.example
